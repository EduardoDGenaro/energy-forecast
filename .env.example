# Configuracao de ambiente
ENVIRONMENT=development
LOG_LEVEL=INFO

# Caminhos e configuracoes de projeto
PROJECT_CONFIG_PATH=config/settings.yaml
DUCKDB_PATH=data/energy_forecast.duckdb
DBT_PROFILES_DIR=dbt

# Fonte de dados oficial ONS
ONS_S3_BASE_URL=https://ons-aws-prod-opendata.s3.amazonaws.com/dataset/carga_energia_di
ONS_CKAN_API_URL=https://dados.ons.org.br/api/3/action/package_show?id=carga-energia
TARGET_SUBSYSTEM=SE
START_YEAR=2018

# Modelagem e rastreamento de experimentos (MLflow)
FORECAST_HORIZON=7
MLFLOW_TRACKING_URI=sqlite:///artifacts/mlflow.db
MLFLOW_EXPERIMENT_NAME=ons-se-load-forecast

